# ─── Backend API ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# ─── Firebase Analytics ───────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → Web App
NUXT_PUBLIC_FIREBASE_ENABLED=false
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Analytics / Observability ────────────────────────────────────────────────
NUXT_PUBLIC_ANALYTICS_ENVIRONMENT=production
VITE_APP_RELEASE_VERSION=
VITE_CLIENT_ERROR_REPORTING_ENABLED=true

# ─── Feature flags ────────────────────────────────────────────────────────────
NUXT_PUBLIC_SHOW_ALL_HOUSES=false
NUXT_PUBLIC_HIDE_ALL_HOUSES=false

# ─── Backend PostgreSQL (set on server, not in frontend) ──────────────────────
# ENABLE_FINISHED_GAME_PERSISTENCE=true
# POSTGRES_DSN=postgres://gamepoly:PASSWORD@127.0.0.1:5432/gamepoly?sslmode=disable
# POSTGRES_MAX_CONNS=10
# POSTGRES_MIN_CONNS=1
# POSTGRES_CONNECT_TIMEOUT_SECONDS=5
# ENABLE_CLIENT_ERROR_PERSISTENCE=true

# ─── Backend (Redis / Auth) ───────────────────────────────────────────────────
# PORT=8080
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# JWT_SECRET=dev-secret-change-in-production
# ENVIRONMENT=production
